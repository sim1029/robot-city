PORT=3000
DB_PATH=./data/robot-city.db

# Required for vault encryption — use a strong random secret in prod
VAULT_PASSPHRASE=change-me-to-a-strong-secret

# Discord app credentials — https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# Optional: plaintext API keys as fallback when vault is empty
# Vault-stored keys take precedence over these
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
