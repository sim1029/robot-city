PORT=3000
DB_PATH=./data/robot-city.db

# Required for vault encryption — use a strong random secret in prod
VAULT_PASSPHRASE=change-me-to-a-strong-secret

# Discord app credentials — https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
# Bot OAuth bootstrap (channel/forum setup)
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback
# Admin dashboard login (separate redirect — must also be registered in Discord Developer Portal)
DISCORD_LOGIN_REDIRECT_URI=http://localhost:3000/auth/discord/login/callback

# Your Discord user ID — only this user can log in to the admin dashboard.
# Enable Developer Mode in Discord, right-click your name → Copy User ID.
OWNER_DISCORD_ID=

# Optional: plaintext API keys as fallback when vault is empty
# Vault-stored keys take precedence over these
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Gmail OAuth (Google Cloud Console > OAuth 2.0 Client IDs)
# Scopes: gmail.modify, gmail.send, userinfo.email
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
